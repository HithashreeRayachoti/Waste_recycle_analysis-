# Postgres operational source (docker compose sets these for you)
NYRT_PG_DSN=postgresql://nyrt:nyrt@localhost:5432/nyrt
# Where bronze/silver/gold files and the DuckDB warehouse live
NYRT_DATA_DIR=./data
# Optional: Socrata app token raises the API rate limit (https://data.cityofnewyork.us/profile/edit/developer_settings)
NYRT_SOCRATA_APP_TOKEN=
# Optional: send records through the ingestion service instead of writing to Postgres directly
NYRT_INGEST_URL=
# Modeled recovery is computed only from rates marked verified=true, unless this is set to 1
NYRT_ALLOW_UNVERIFIED_RATES=0
